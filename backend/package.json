{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "description": "REST API for the self-improvement app (Express + PostgreSQL)",
  "main": "server.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "node --watch server.js",
    "dev:neon": "node --env-file=../.env.local --watch server.js",
    "start": "node server.js",
    "migrate": "node-pg-migrate",
    "migrate:test": "node --env-file=.env.test node_modules/node-pg-migrate/bin/node-pg-migrate.js",
    "migrate:neon": "node --env-file=../.env.local node_modules/node-pg-migrate/bin/node-pg-migrate.js -d DATABASE_URL_UNPOOLED"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Teaa3052/web-app.git"
  },
  "author": "Tea",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Teaa3052/web-app/issues"
  },
  "homepage": "https://github.com/Teaa3052/web-app#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.16.3",
    "zod": "^4.6.7"
  },
  "keywords": [],
  "devDependencies": {
    "supertest": "^7.3.2",
    "vitest": "^5.1.1"
  }
}
